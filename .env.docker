# Database
DATABASE_URL="postgresql://admin:admin123@localhost:5432/automix?schema=public"
REDIS_URL=redis://localhost:6379

# Analyzer
ANALYZER_URL=http://analyzer:8000

# AWS S3
STORAGE_DRIVER=s3
S3_BUCKET=your-automix-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=your-secret-key
# Do NOT set S3_ENDPOINT for real AWS S3

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PUBLIC_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000

# Temp directory
TMP_DIR=/app/tmp