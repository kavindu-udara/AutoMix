generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id               String   @id @default(cuid())
  originalFileName String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  durationSec      Float?
  status           String   @default("uploaded")
  bpm              Float?
  analysisJson     String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
