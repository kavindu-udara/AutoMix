generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id               String   @id @default(cuid())
  originalFileName String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  durationSec      Float?
  status           String   @default("uploaded")
  bpm              Float?
  analysisJson     String?
  error            String?

  musicalKey       String?   
  camelot          String?   
  keyMode          String?   
  keyConfidence    Float?  

  stemsStatus      String? 
  stemsVocalsKey   String? 
  stemsDrumsKey    String? 
  stemsBassKey     String? 
  stemsOtherKey    String? 
  stemsError       String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mixes            MixTrack[]
}

model Mix {
  id           String     @id @default(cuid())
  name         String     @default("Untitled Mix")
  status       String     @default("planning") // planning, planned, rendering, completed, failed
  targetBpm    Float?
  planJson     String?

  outputStorageKey String?
  renderError      String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tracks       MixTrack[]
}

model MixTrack {
  id        String   @id @default(cuid())
  mixId     String
  trackId   String
  order     Int
  
  mix       Mix      @relation(fields: [mixId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([mixId, trackId])
  @@index([mixId, order])
}
